<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<% if (cssurl) { %>
<link rel="stylesheet" href="<%= cssurl %>">
<% } %>
<meta name="viewport" content="width=device-width, user-scalable=no, initial-scale=1">
<title><%= blogtitle %></title>
</head>
<body>
<header>
  <div id="blogTitle"><%= blogtitle %></div>
  <div id="returnText">
    <a class="nohighlight" href="<%= returnurl %>"><%= returntext %></a>
  </div>
</header>
<article id="descWrap">
  <p id="desc"> <%- blogdesc.replace(/\n/g, "<br>") %></p>
</article>
<% if (tags && tags.length) { %>
<div id="tagListWrap">
  <% tags.forEach(t => { %>
    <% const isActive = t.isAll ? !currentTag : (t.name === currentTag); %>
    <a class="nohighlight" href="<%= t.link %>"><div class="tag<%= isActive ? ' tagActive' : '' %>"><%= t.name %> (<%= t.count %>)</div></a>
  <% }) %>
</div>
<% } %>
<main>
<article id="listWrap">
  <div class="indexlist listSize">
    <% items.forEach(item => { %>
      <a class="nohighlight" href="<%= item.link %>">
        <div class="indexitem">
          <div class="titlearea" style="background-image: url('<%= item.image %>')">
            <div class="itemdate"><p><%= item.datetime %></p></div>
            <div class="itemtitle"><p><%= item.title %></p></div>
          </div>
          <div class="bodytext"><p><%= item.bodytext %></p></div>
        </div>
      </a>
    <% }) %>
  </div>
</article>
</main>
<nav class="pager">
  <% if (prevPage) { %>
    <a href="<%= prevPage === 1 ? 'index.html' : `index-${prevPage}.html` %>">
      ← Newer posts
    </a>
  <% } %>

  <% if (nextPage) { %>
    <a href="index-<%= nextPage %>.html">
      Older posts →
    </a>
  <% } %>
</nav>
<footer><%= footertext %><span class="separator"></span><span class="possgCredit">gen with <a class="nohighlight" href="https://github.com/tadfmac/possg"><strong>possg</strong></a></span></footer>

<% if (gaid) { %>
  <!-- Google Analytics -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=<%= gaid %>"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', '<%= gaid %>');
  </script>
<% } %>
</body>
</html>
